# Keep the build context small. `target/` alone is ~13 GB locally and would
# otherwise be uploaded to the builder on every deploy.
target/
**/target/
node_modules/

# The static export is a separate artifact, regenerated by the export bin;
# the fullstack image serves the live app instead.
export/
**/export/

# The marp deck and its JS prototypes are being retired and play no part in
# the deployed app. Anchored to the repo root on purpose: an unanchored
# `*.js` would also drop anything the crate's assets/ may hold later.
/marp-theme-rhea/
/lib/
/slides.html
/slides.standalone.html
/slides.md
/broadcast.html
/mpsc.html
/oneshot.html
/watch.html
/broadcast.js
/mpsc.js
/oneshot.js
/watch.js
/bundle.mjs
/package.json
/package-lock.json
/.prettierrc.json

# A stray top-level crate that is not part of the app workspace.
/src/
/Cargo.toml
/Cargo.lock

.git/
.github/
*.log
.DS_Store
